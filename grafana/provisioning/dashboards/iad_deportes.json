                    "rawQuery": true,
                    "rawSql": "SELECT DISTINCT ON (r.time) TO_CHAR(r.time AT TIME ZONE 'Europe/Madrid', 'Dy HH24h') as hora, r.score, r.label, w.temperature as temp, w.wind_speed as viento, w.precipitation as lluvia, w.sky_state as cielo FROM meteogalicia.iad_scores r JOIN meteogalicia.weather_hourly w ON r.time = w.time AND r.coord_index = w.coord_index WHERE r.coord_index = ${zona} AND r.sport = '${deporte}' AND r.time >= NOW() ORDER BY r.time ASC LIMIT 24",
