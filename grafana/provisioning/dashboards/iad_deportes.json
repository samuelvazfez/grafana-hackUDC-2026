                    "editorMode": "code",
                    "format": "table",
                    "rawQuery": true,
                    "rawSql": "SELECT CASE coord_index WHEN 0 THEN 'A Coruña' WHEN 1 THEN 'Santiago' WHEN 2 THEN 'Vigo' WHEN 3 THEN 'Lugo' WHEN 4 THEN 'Ourense' WHEN 5 THEN 'Pontevedra' END as \"Zona\", MAX(CASE WHEN sport='running' THEN score END) as \"🏃\", MAX(CASE WHEN sport='cycling' THEN score END) as \"🚴\", MAX(CASE WHEN sport='mtb' THEN score END) as \"🚵\", CASE (array_agg(sport ORDER BY score DESC))[1] WHEN 'running' THEN '🏃 Running' WHEN 'cycling' THEN '🚴 Ciclismo' WHEN 'mtb' THEN '🚵 MTB' END as \"⭐ Mejor\" FROM (SELECT DISTINCT ON (coord_index, sport) coord_index, sport, score FROM meteogalicia.iad_scores WHERE time >= NOW() ORDER BY coord_index, sport, time ASC, ts_ingested DESC) scores GROUP BY coord_index ORDER BY coord_index",
