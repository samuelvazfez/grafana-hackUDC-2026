                    "rawQuery": true,
                    "rawSql": "SELECT DISTINCT ON (coord_index) time, TO_CHAR(time AT TIME ZONE 'Europe/Madrid', 'Dy DD Mon HH24:MI') || ' → IAD ' || ROUND(score,1) as ventana FROM meteogalicia.iad_scores WHERE coord_index = ${zona} AND sport = '${deporte}' AND time >= NOW() AND score >= 8 ORDER BY coord_index, time ASC",
