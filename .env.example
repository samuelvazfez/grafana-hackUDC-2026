# .env.example
# CAMBIAR las contraseñas y API keys

POSTGRES_USER=admin
POSTGRES_PASSWORD=
POSTGRES_DB=observability
POSTGRES_PORT=5432

GRAFANA_USER=admin
GRAFANA_PASSWORD=

# Versiones
TIMESCALE_IMAGE=timescale/timescaledb:latest-pg16
GRAFANA_IMAGE=grafana/grafana-oss:latest

# Red y puertos host
GRAFANA_PORT=3000

# MeteoSIX
METEOSIX_API_KEY=
METEOSIX_BASE_URL=https://servizos.meteogalicia.gal/apiv5
METEOSIX_OPERATION=getNumericForecastInfo
METEOSIX_FORMAT=application/json
METEOSIX_LANG=gl
METEOSIX_COORDS=-8.409,43.362;-8.546,42.880;-8.720,42.240;-7.556,43.012;-7.864,42.336;-8.644,42.431

# AEMET (dejar vacío para desactivar)
AEMET_API_KEY=
AEMET_BASE_URL=https://opendata.aemet.es/opendata

# Scheduler + caché
POLL_SECONDS=21600
POLL_AEMET_SECONDS=1800
CACHE_TTL_SECONDS=93600

# ── Alerting ──────────────────────────────────────────────────────────────────
# Discord Webhook URL para recibir alertas
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/1477349195156557827/hSEiFiekRmfEoIBJmoJrIjq-RNqxtJAyY7vywdDqnoxLGkPTYc9wMmHmnqj1Caal2J7J